{
  "name": "dsh-memory-pg",
  "version": "0.2.2",
  "description": "PostgreSQL-backed long-term memory for DeepSeek Harness: native memory tools + a per-turn memory preamble (vector ⊕ keyword ⊕ graph recall, four-state write arbitration, day/week/month/year keyword digests).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "postgresql",
    "pgvector",
    "agent-memory",
    "rag"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lq287/ai-memory-pg.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/lq287/ai-memory-pg#readme",
  "bugs": {
    "url": "https://github.com/lq287/ai-memory-pg/issues"
  }
}
