# 复制成 .env 后按需改；不填 LLM 相关变量也能跑（会退到规则替身）

# --- 数据库 ---------------------------------------------------------------
# 本机原生 PG（推荐，已装 pgvector 0.8.7）
MEM_PG_DSN=postgresql://mem:mem@127.0.0.1:5432/mem
# 无 Docker 时用 PGlite 起的临时库（npm run serve）
# MEM_PG_DSN=postgresql://postgres@127.0.0.1:55433/postgres

# --- 向量化 ---------------------------------------------------------------
# 三种写法，按优先级：
#   onnx[:dir]  本地 ONNX 模型（推荐：离线、免密钥、768 维正好匹配现有列）
#   hash-768    零依赖替身（只用于本地跑通/单测，不是语义向量 —— 别用在真实记忆上）
#   其它        当作 OpenAI 兼容 /embeddings 的模型名（需配 MEM_LLM_BASE_URL）
MEM_EMBED_MODEL=onnx
MEM_EMBED_DIM=768
MEM_ONNX_MODEL_DIR=vendor/models/bge-base-zh-v1.5
MEM_ONNX_MODEL_NAME=bge-base-zh-v1.5
# 池化方式：留空=按模型名推断（bge→cls，e5→mean）。选错不报错但相似度会整体失真
MEM_ONNX_POOLING=
# 查询侧指令前缀：bge v1.5 已取消要求，实测加上反而 Top-1 从 10/12 掉到 9/12，故留空
MEM_EMBED_QUERY_PREFIX=

# 云端写法（OpenAI / 兼容端点）。注意：改维度必须同步改 schema 的 vector(N) 并全量重算
# MEM_EMBED_MODEL=text-embedding-3-small
# MEM_EMBED_DIM=1536
# MEM_LLM_BASE_URL=https://api.openai.com/v1
# MEM_LLM_API_KEY=sk-...

# --- LLM（两次调用：抽取 + 裁决建议）-------------------------------------
# 留空 => 使用 HeuristicLLM 规则替身（能跑通链路，但没有真正的语义理解）
MEM_LLM_BASE_URL=
# MEM_LLM_BASE_URL=https://api.openai.com/v1
# MEM_LLM_BASE_URL=http://127.0.0.1:11434/v1        # Ollama
MEM_LLM_API_KEY=
MEM_LLM_MODEL=gpt-4o-mini

# --- worker ---------------------------------------------------------------
MEM_WORKER_ID=
MEM_BATCH_SIZE=10
# 租约：worker 崩溃后，超过这个时长仍未确认的任务会被其他 worker 回收
MEM_LEASE_SECONDS=300

# --- 记忆归属 -------------------------------------------------------------
# mem.py / demo / worker 用的 user_id；每个主体一份独立记忆空间
MEM_USER_ID=owner
